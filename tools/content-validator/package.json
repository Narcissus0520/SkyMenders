{
  "name": "@skymenders/content-validator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "pnpm --filter @skymenders/content-validator... run build && node dist/cli.js"
  },
  "dependencies": {
    "@skymenders/content-schema": "workspace:*",
    "@skymenders/content-runtime": "workspace:*",
    "@skymenders/ai-core": "workspace:*",
    "@skymenders/battle-core": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
