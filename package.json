{
  "name": "skymenders",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SkyMenders deterministic engineering tactics game monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.31.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=10.0.0 <11"
  },
  "scripts": {
    "assets:audit": "pnpm --filter @skymenders/asset-auditor run audit",
    "assets:audit:release": "pnpm --filter @skymenders/asset-auditor run audit:release",
    "backup:drill": "pnpm --filter @skymenders/database-tools run backup:drill",
    "build": "turbo run build",
    "cocos:build:wechat": "pnpm --filter @skymenders/cocos-build run build:wechat",
    "cocos:check": "pnpm --filter @skymenders/cocos-build run check",
    "content:freeze:check": "pnpm --filter @skymenders/release-preflight run freeze:check",
    "content:freeze:write": "pnpm --filter @skymenders/release-preflight run freeze:write",
    "content:rollback:drill": "pnpm --filter @skymenders/content-gateway run drill:rollback",
    "content:validate": "pnpm --filter @skymenders/content-validator run validate && pnpm --filter @skymenders/ai-core run validate:catalog",
    "db:generate": "pnpm --filter @skymenders/game-server run db:generate",
    "db:migrate": "pnpm --filter @skymenders/game-server run db:migrate",
    "dev": "turbo run dev --parallel",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "infra:down": "docker compose down",
    "infra:up": "docker compose up -d --wait",
    "infra:validate": "pnpm --filter @skymenders/project-guard run infra:validate",
    "lint": "turbo run lint",
    "package:budget": "pnpm --filter @skymenders/package-budget run audit",
    "package:budget:release": "pnpm --filter @skymenders/package-budget run audit:release",
    "release:check": "pnpm content:freeze:check && pnpm save:migration:drill && pnpm content:rollback:drill && pnpm assets:audit && pnpm package:budget && pnpm --filter @skymenders/release-preflight run check",
    "release:gate": "pnpm content:freeze:check && pnpm save:migration:drill && pnpm content:rollback:drill && pnpm assets:audit:release && pnpm package:budget:release && pnpm --filter @skymenders/release-preflight run gate",
    "save:migration:drill": "pnpm --filter @skymenders/save-migration run drill:migration",
    "security:audit": "pnpm --config.registry=https://registry.npmjs.org/ audit --audit-level high",
    "security:sbom": "pnpm --filter @skymenders/project-guard run sbom:generate",
    "security:secrets": "pnpm --filter @skymenders/project-guard run secrets:scan",
    "test": "turbo run test",
    "test:integration": "pnpm --filter @skymenders/game-server run test:integration && pnpm --filter @skymenders/game-worker run test:integration",
    "pretest:e2e": "turbo run build --filter=@skymenders/game-server --filter=@skymenders/content-gateway --filter=@skymenders/content-studio --filter=@skymenders/admin-console",
    "test:e2e": "playwright test",
    "e2e:services": "tsx e2e/services.ts",
    "test:coverage": "turbo run test:coverage --concurrency=4",
    "test:determinism": "turbo run test:determinism",
    "test:performance": "turbo run test:performance",
    "typecheck": "turbo run typecheck",
    "workspace:check": "pnpm --filter @skymenders/project-guard run workspace:check"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@types/node": "catalog:",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "globals": "catalog:",
    "prettier": "catalog:",
    "turbo": "^2.5.0",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma"
    ]
  }
}
