generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id              String              @id @db.Uuid
  createdAt       DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime            @updatedAt @db.Timestamptz(3)
  platformSubject PlatformSubject?
  sessions        Session[]
  profile         Profile?
  progress        AccountProgress?
  unlocks         Unlock[]
  achievements    Achievement[]
  expeditionSave  ExpeditionSave?
  recoveryRecords SaveRecovery[]
  privacyRequests PrivacyRequest[]
  idempotency     IdempotencyRecord[]
  dailyAttempts   DailyAttempt[]
  leaderboard     LeaderboardEntry[]
  riskEvents      ReplayRiskEvent[]

  @@map("accounts")
}

model PlatformSubject {
  id          String   @id @db.Uuid
  accountId   String   @unique @db.Uuid
  platform    String
  subjectHash String   @unique @db.VarChar(64)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([platform, subjectHash])
  @@map("platform_subjects")
}

model Session {
  id               String    @id @db.Uuid
  accountId        String    @db.Uuid
  refreshTokenHash String    @unique @db.VarChar(64)
  deviceKind       String    @db.VarChar(16)
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt        DateTime  @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  account          Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("sessions")
}

model Profile {
  accountId  String   @id @db.Uuid
  systemCode String   @unique @db.VarChar(64)
  settings   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model AccountProgress {
  accountId    String   @id @db.Uuid
  logicalClock Int
  document     Json
  updatedAt    DateTime @db.Timestamptz(3)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("account_progress")
}

model Unlock {
  accountId  String   @db.Uuid
  unlockId   String   @db.VarChar(96)
  unlockedAt DateTime @default(now()) @db.Timestamptz(3)
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, unlockId])
  @@map("unlocks")
}

model Achievement {
  accountId     String   @db.Uuid
  achievementId String   @db.VarChar(96)
  unlockedAt    DateTime @default(now()) @db.Timestamptz(3)
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@id([accountId, achievementId])
  @@map("achievements")
}

model ExpeditionSave {
  accountId    String   @id @db.Uuid
  revision     Int
  logicalClock Int
  document     Json
  updatedAt    DateTime @db.Timestamptz(3)
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("expedition_saves")
}

model SaveRecovery {
  id        String   @id @db.Uuid
  accountId String   @db.Uuid
  kind      String   @db.VarChar(32)
  document  Json
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, expiresAt])
  @@map("save_recovery")
}

model PrivacyRequest {
  id          String    @id @db.Uuid
  accountId   String?   @db.Uuid
  kind        String    @db.VarChar(16)
  status      String    @db.VarChar(16)
  createdAt   DateTime  @default(now()) @db.Timestamptz(3)
  completedAt DateTime? @db.Timestamptz(3)
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@map("privacy_requests")
}

model IdempotencyRecord {
  id         String   @id @db.Uuid
  accountId  String   @db.Uuid
  route      String   @db.VarChar(128)
  key        String   @db.VarChar(128)
  statusCode Int
  response   Json
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  expiresAt  DateTime @db.Timestamptz(3)
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, route, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

model DailyChallenge {
  id             String             @id @db.VarChar(240)
  businessDate   DateTime           @db.Date
  rulesVersion   String             @db.VarChar(32)
  contentVersion String             @db.VarChar(32)
  seed           BigInt
  definition     Json
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)
  attempts       DailyAttempt[]
  leaderboard    LeaderboardEntry[]

  @@unique([businessDate, rulesVersion, contentVersion])
  @@map("daily_challenges")
}

model DailyAttempt {
  id              String            @id @db.Uuid
  accountId       String            @db.Uuid
  challengeId     String            @db.VarChar(240)
  mode            String            @db.VarChar(16)
  formalSlot      Int?
  status          String            @db.VarChar(16)
  checkpointIndex Int?
  checkpoint      Json?
  startedAt       DateTime          @db.Timestamptz(3)
  updatedAt       DateTime          @db.Timestamptz(3)
  completedAt     DateTime?         @db.Timestamptz(3)
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  challenge       DailyChallenge    @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  submission      ReplaySubmission?

  @@unique([accountId, challengeId, formalSlot])
  @@index([accountId, challengeId, status])
  @@map("daily_attempts")
}

model ReplaySubmission {
  id            String            @id @db.Uuid
  attemptId     String            @unique @db.Uuid
  request       Json
  status        String            @db.VarChar(16)
  score         Int?
  totalTurns    Int?
  rejectionCode String?           @db.VarChar(48)
  createdAt     DateTime          @db.Timestamptz(3)
  updatedAt     DateTime          @db.Timestamptz(3)
  verifiedAt    DateTime?         @db.Timestamptz(3)
  attempt       DailyAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  leaderboard   LeaderboardEntry?
  riskEvent     ReplayRiskEvent?

  @@index([status, createdAt])
  @@map("replay_submissions")
}

model LeaderboardEntry {
  id                 String           @id @db.Uuid
  challengeId        String           @db.VarChar(240)
  accountId          String           @db.Uuid
  submissionId       String           @unique @db.Uuid
  systemCode         String           @db.VarChar(64)
  avatarId           String           @db.VarChar(96)
  score              Int
  completionMs       Int
  turns              Int
  completionStatus   String           @db.VarChar(16)
  verificationStatus String           @db.VarChar(16)
  createdAt          DateTime         @db.Timestamptz(3)
  updatedAt          DateTime         @db.Timestamptz(3)
  challenge          DailyChallenge   @relation(fields: [challengeId], references: [id], onDelete: Restrict)
  account            Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  submission         ReplaySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([challengeId, accountId])
  @@index([challengeId, score(sort: Desc), completionMs, turns, createdAt])
  @@map("leaderboard_entries")
}

model ReplayRiskEvent {
  id           String           @id @db.Uuid
  accountId    String           @db.Uuid
  submissionId String           @unique @db.Uuid
  code         String           @db.VarChar(48)
  createdAt    DateTime         @db.Timestamptz(3)
  account      Account          @relation(fields: [accountId], references: [id], onDelete: Cascade)
  submission   ReplaySubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@index([code, createdAt])
  @@map("replay_risk_events")
}
